{
  "$defs": {
    "Component": {
      "description": "Embedded sub-document inside `Meal.components`.\n\n`name` is copied from `GhanaFood.name` at write time for matched\ncomponents so deletions from the catalogue do not break history.\n`kcal_low / kcal_high / confidence` are vision-only fields \u2014 Phase 3\nwrites them as None; Phase 4 fills them.",
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "matched_food_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Food Id"
        },
        "portion_g": {
          "maximum": 800,
          "minimum": 10,
          "title": "Portion G",
          "type": "integer"
        },
        "kcal_low": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kcal Low"
        },
        "kcal_high": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kcal High"
        },
        "kcal_point": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Kcal Point",
          "type": "integer"
        },
        "protein_g_point": {
          "maximum": 600,
          "minimum": 0,
          "title": "Protein G Point",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "source": {
          "enum": [
            "table",
            "llm_then_table_rematch",
            "user_corrected"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "portion_g",
        "kcal_point",
        "protein_g_point",
        "source"
      ],
      "title": "Component",
      "type": "object"
    }
  },
  "description": "Full Meal document as stored in `meals` collection.",
  "properties": {
    "user_id": {
      "pattern": "^user_[a-zA-Z0-9_]+$",
      "title": "User Id",
      "type": "string"
    },
    "logged_at": {
      "format": "date-time",
      "title": "Logged At",
      "type": "string"
    },
    "source": {
      "enum": [
        "manual",
        "ai_vision"
      ],
      "title": "Source",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "total_kcal": {
      "minimum": 0,
      "title": "Total Kcal",
      "type": "integer"
    },
    "total_protein_g": {
      "minimum": 0,
      "title": "Total Protein G",
      "type": "integer"
    },
    "ai_metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ai Metadata"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "logged_at",
    "source",
    "components",
    "total_kcal",
    "total_protein_g",
    "created_at",
    "updated_at"
  ],
  "title": "Meal",
  "type": "object"
}
