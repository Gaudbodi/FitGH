# FitGH backend env example.
# Copy to .env.local (gitignored) and fill in real values. Never commit
# .env.local. Render injects production values at deploy time per
# render.yaml `sync: false` entries.
#
# Sourced env (Phase 1 baseline + Phase 4):

# --- Phase 1: Atlas + Clerk + CORS ---
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.pcd3g.mongodb.net/fitgh?retryWrites=true&w=majority
CLERK_SECRET_KEY=sk_test_...
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://fitgh-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 4: Image -> Kcal Core Loop ---
# Anthropic Sonnet 4.6 vision API key. Get one at
# https://console.anthropic.com → Settings → API keys → Create key.
# Add at least $5 of prepaid billing credit before first call.
ANTHROPIC_API_KEY=sk-ant-...

# Env-pinned per CONTEXT D-VISION-MODEL-PIN. Bumping requires updating
# MODEL_PRICING_PER_1K in app/lib/vision.py AND re-running the golden
# set (Phase 7). Default is fine for v1.
LLM_VISION_MODEL=claude-sonnet-4-6

# Global $/day circuit breaker. After this much spend, all subsequent
# /meals/scan calls return 503 until the next UTC day. Default $5.
VISION_DAILY_CAP_USD=5.0

# Optional. If set, the cost-alert (OBS-03) POSTs a Discord/Slack-compatible
# {content: "..."} payload to this URL when spend_per_DAU exceeds $0.05.
# If empty, WARN-logs to Render stdout instead — still observable.
COST_ALERT_WEBHOOK_URL=
