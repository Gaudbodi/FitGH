# Copy to backend/.env (Flask) and frontend/.env.local (Next.js). NEVER commit real values.
# Phase 1 Walking Skeleton — Render-only deploy (2026-05-12 rewrite).
# All values come from the three SaaS dashboards or Render's Environment tab.

# --- MongoDB Atlas ---
# Source: Atlas Dashboard -> Database -> Connect -> Drivers (fitgh-app user, readWrite@fitgh only).
# Stored in Render's fitgh-api Environment tab as a sync:false secret in production.
MONGODB_URI=

# --- Clerk (Auth) ---
# Source: Clerk Dashboard -> API Keys.
# Used by both the Next.js frontend (publishable key client-side, secret server-side)
# AND the Flask backend (secret for JWKS bootstrap; networkless verification after).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<from-clerk-dashboard>
CLERK_SECRET_KEY=<from-clerk-dashboard>
# Comma-separated allowed `azp` values on the Clerk JWT. Local: http://localhost:3000.
# Production: the Render fitgh-web URL (e.g. https://fitgh-web.onrender.com).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Frontend -> Backend wiring ---
# Source: Render Dashboard -> fitgh-api service -> URL (assigned at first Blueprint provision).
# Local dev = http://localhost:8000. The Next.js BFF (/api/me) reads this to call Flask.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Flask runtime ---
# `development` locally (skips Config.validate strictness); `production` on Render (fail-loud).
FLASK_ENV=development

# --- Phase 4 (Vision pipeline) ---
# Source: Anthropic Console -> API Keys.
# Used by the Flask backend to call Claude Sonnet 4.6 for the snap-meal loop.
ANTHROPIC_API_KEY=
# Pin the production vision model. Bump triggers a golden-set re-run per
# backend/tests/golden_set/README.md.
LLM_VISION_MODEL=claude-sonnet-4-6
# Global daily $/day vision-spend cap. When exceeded, /meals/scan returns
# 503 service_paused. Phase 4 OBS-03.
VISION_DAILY_CAP_USD=5.00
# Discord/Slack incoming-webhook URL for the $/DAU/day > $0.05 cost alert
# (Phase 4 OBS-03 — falls back to WARN log if unset). See LAUNCH.md §4 for
# Discord/Slack setup steps. Phase 7 documents this in .env.example so the
# operator knows to provision it before launch.
COST_ALERT_WEBHOOK_URL=

# --- Phase 7 (Launch hardening) ---
# Render injects this automatically as RENDER_GIT_COMMIT. Map via render.yaml
# OR paste the short SHA manually. Surfaces in /me/export response as
# _export_metadata.app_version so a downloaded archive carries the build
# fingerprint. LAUNCH.md §1 has the render.yaml mapping snippet.
FITGH_GIT_SHA=
