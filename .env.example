# Copy to .env.local (frontend) and .env (backend). NEVER commit real values.

# --- MongoDB ---
# Atlas connection string. Rotate password if it was ever pasted into chat / logs.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.pcd3g.mongodb.net/fitgh?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=fitgh

# --- LLM Vision (pick one) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Auth (if Supabase / NextAuth chosen later) ---
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# --- Backend ---
FLASK_ENV=development
BACKEND_URL=http://localhost:5000
