# Copy to backend/.env (Flask) and frontend/.env.local (Next.js). NEVER commit real values.
# Phase 1 Walking Skeleton — Render-only deploy (2026-05-12 rewrite).
# All values come from the three SaaS dashboards or Render's Environment tab.

# --- MongoDB Atlas ---
# Source: Atlas Dashboard -> Database -> Connect -> Drivers (fitgh-app user, readWrite@fitgh only).
# Stored in Render's fitgh-api Environment tab as a sync:false secret in production.
MONGODB_URI=

# --- Clerk (Auth) ---
# Source: Clerk Dashboard -> API Keys.
# Used by both the Next.js frontend (publishable key client-side, secret server-side)
# AND the Flask backend (secret for JWKS bootstrap; networkless verification after).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<from-clerk-dashboard>
CLERK_SECRET_KEY=<from-clerk-dashboard>
# Comma-separated allowed `azp` values on the Clerk JWT. Local: http://localhost:3000.
# Production: the Render fitgh-web URL (e.g. https://fitgh-web.onrender.com).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Frontend -> Backend wiring ---
# Source: Render Dashboard -> fitgh-api service -> URL (assigned at first Blueprint provision).
# Local dev = http://localhost:8000. The Next.js BFF (/api/me) reads this to call Flask.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Flask runtime ---
# `development` locally (skips Config.validate strictness); `production` on Render (fail-loud).
FLASK_ENV=development
