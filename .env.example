# Copy to .env.local (frontend) and backend/.env (backend). NEVER commit real values.
# Phase 1 Walking Skeleton — all env vars required for the full stack to run end-to-end.

# --- MongoDB Atlas ---
# Rotated fitgh-app user (readWrite@fitgh only — NOT atlasAdmin). See PITFALLS M-5.
MONGODB_URI=

# --- Clerk (Auth) ---
# Get from: Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<from-clerk-dashboard>
CLERK_SECRET_KEY=<from-clerk-dashboard>
# Webhook signing secret (Clerk Dashboard -> Webhooks -> endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=<from-clerk-dashboard>
# Comma-separated allowed origins for Clerk JWT `azp` claim verification (Flask side)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://fitgh.vercel.app

# --- Frontend -> Backend wiring ---
# URL of the deployed Flask API (Fly.io). Local dev = http://localhost:8000.
BACKEND_URL=http://localhost:8000
# Public origin of the Next.js app (used by server components calling /api/me).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Flask CORS ---
# Comma-separated origins permitted to call the Flask API. NEVER `*` with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Sentry (Observability) ---
# Backend DSN (Sentry project: fitgh-backend, Python Flask)
SENTRY_DSN_BACKEND=<from-sentry-dashboard>
# Frontend DSN (Sentry project: fitgh-frontend, Next.js) — exposed to client
NEXT_PUBLIC_SENTRY_DSN=<from-sentry-dashboard>
# Org-scoped auth token for source-map upload during Vercel build
SENTRY_AUTH_TOKEN=<from-sentry-dashboard>

# --- Flask runtime ---
FLASK_ENV=development
